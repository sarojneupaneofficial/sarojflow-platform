# ─── SarojFlow Environment Configuration ───────────────────────────────────

# Kafka
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC_RAW=traffic.raw.events
KAFKA_TOPIC_CLEAN=traffic.clean.events
KAFKA_TOPIC_ANOMALIES=traffic.anomalies
KAFKA_TOPIC_ALERTS=traffic.alerts

# Producer
EVENTS_PER_SECOND=10
NUM_CAMERAS=12

# Postgres
POSTGRES_USER=sarojflow
POSTGRES_PASSWORD=sarojflow123
POSTGRES_DB=sarojflow
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# API
SECRET_KEY=change-me-in-production-use-a-strong-random-string
API_HOST=0.0.0.0
API_PORT=8000

# Delta Lake
DELTA_LAKE_PATH=./data/delta

# Anomaly Detection
ANOMALY_THRESHOLD=0.85
CONGESTION_SPIKE_PCT=200
MIN_SPEED_ALERT=10

# Airflow
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=admin
